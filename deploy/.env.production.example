# BKO Quad Hub — variables de production app.bkoquad.ml.
# Copier ce fichier vers deploy/.env.production (JAMAIS commité) puis remplacer
# toutes les valeurs "change-me". Générer la clé Django avec :
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Générer le mot de passe PostgreSQL avec :
#   openssl rand -base64 32

DJANGO_SECRET_KEY=change-me-long-random-secret
DJANGO_DEBUG=0
BKO_PUBLIC_HOST=app.bkoquad.ml
DJANGO_ALLOWED_HOSTS=app.bkoquad.ml,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://app.bkoquad.ml
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_PRELOAD=0

# PostgreSQL (conteneur db)
POSTGRES_DB=bko_quad
POSTGRES_USER=bko
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
DB_CONN_MAX_AGE=60

# Redis / Celery (conteneurs redis, worker, beat)
REDIS_URL=redis://redis:6379/0
CELERY_TASK_TIME_LIMIT=300

# Valeurs métier BKO Quad (FCFA entiers)
BKO_DEFAULT_DEPOSIT_XOF=10000
BKO_BOOKING_EXPIRY_MINUTES=240
BKO_REFUND_POLICY=manual
BKO_WHATSAPP_BUSINESS_NUMBER=+22300000000
BKO_CLOSING_HOUR=20

# Sauvegarde chiffrée (utilisée par deploy/backup-postgres.sh, pas par Django)
BACKUP_PASSPHRASE=change-me-backup-passphrase
